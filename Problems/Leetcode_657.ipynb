      "source": [
        "class Solution:\n",
        "  def judgeCircle(self , moves : str) -> bool:\n",
        "    return moves.count(\"L\") == moves.count(\"R\") and moves.count(\"U\") == moves.count(\"R\")\n",
        "\n",
        "s = Solution()"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "print(s.judgeCircle(moves = \"UDLRDLRUDL\"))"
