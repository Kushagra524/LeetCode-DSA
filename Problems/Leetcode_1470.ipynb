      "source": [
        "from typing import List\n",
        "\n",
        "class Solution:\n",
        "  def shuffle(self , nums : List[int] , n = 3) -> List[int]:\n",
        "    res = []\n",
        "\n",
        "    for i in range(n):\n",
        "      res.append(nums[i])\n",
        "      res.append(nums[i + n])\n",
        "\n",
        "    return res\n",
        "\n",
        "s = Solution()\n",
        "print(s.shuffle(nums = [2,5,1,3,4,7], n = 3))"
      ]
    },
