      "source": [
        "class Solution:\n",
        "  def countCommas(self , n : int) -> int:\n",
        "    if n < 1000:\n",
        "      return 0\n",
        "\n",
        "    commas = 0\n",
        "    num = n\n",
        "    while num >= 1000:\n",
        "      num = num // 1000\n",
        "      commas = commas + 1\n",
        "\n",
        "    return commas * (n - 999)\n",
        "\n",
        "s = Solution()\n",
        "print(s.countCommas(n = 1023))"
      ]
    },
